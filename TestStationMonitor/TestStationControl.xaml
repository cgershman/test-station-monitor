<UserControl 
    x:Class="TestStationMonitor.TestStationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:TestStationMonitor"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance local:TestStationViewModel}"
    Height="50" Width="200" Background="LightBlue">

    <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding Name}" FontSize="16" VerticalAlignment="Center" Margin="10"/>
        <Button Content="Run" Command="{Binding RunTestCommand}" Height="25" Width="60" Margin="10"/>
        <TextBlock Text="{Binding Status}" Width="100" FontSize="16" VerticalAlignment="Center"/>
    </StackPanel>

</UserControl>
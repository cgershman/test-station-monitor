<Window x:Class="TestStationMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TestStationMonitor"
        mc:Ignorable="d"
        Title="Test Station Monitor" Height="450" Width="800">

    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>

    <StackPanel Margin="20">
        <Label Content="{Binding StatusMessage}" Margin="10"/>

        <StackPanel Orientation="Horizontal">
            <Label Content="Station Endpoint: " Margin="10"/>
            
            <TextBox 
                Text="{Binding NewStationEndpoint, UpdateSourceTrigger=PropertyChanged}" 
                Width="200" 
                HorizontalAlignment="Left"
                Margin="0, 10, 10, 10"/>
            
            <Button 
                Content="Add Test Station" 
                Command="{Binding AddTestStationCommand}" 
                Width="100" 
                Margin="0, 10, 10, 10"
                HorizontalAlignment="Left"/>

        </StackPanel>

        <Button 
            Content="Run All" 
            Command="{Binding RunAllCommand}" 
            Width="100" 
            Margin="10"
            HorizontalAlignment="Left"/>

        <Border BorderBrush="Gray" 
            BorderThickness="2" 
            CornerRadius="5" 
            Background="White"
            Margin="10,0,10,10"
            Padding="10,10,10,0"
            HorizontalAlignment="Left">

            <ItemsControl ItemsSource="{Binding TestStations}">
                <ItemsControl.Resources>
                    <DataTemplate DataType="{x:Type local:TestStationViewModel}">
                        <local:TestStationControl />
                    </DataTemplate>
                </ItemsControl.Resources>

                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
            </ItemsControl>
        </Border>
    </StackPanel>

</Window>
